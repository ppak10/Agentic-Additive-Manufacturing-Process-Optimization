# Postgres (consumed by docker-compose.yml and the server)
POSTGRES_DB=inova
POSTGRES_USER=inova
POSTGRES_PASSWORD=inova
POSTGRES_PORT=5432
DATABASE_URL=postgres://inova:inova@localhost:5432/inova

# Inova plugin + firmware endpoints
INOVA_API_BASE_URL=http://192.168.1.146:5001
INOVA_FIRMWARE_BASE_URL=http://192.168.1.146

# Server
SERVER_PORT=3000

# Telemetry / camera polling rates
TELEMETRY_HZ=10
CAMERA_HZ=5
THERMAL_HZ=2

# Where camera frames are written on disk
FRAMES_DIR=./data/frames
