# Postgres (consumed by services/postgres/compose.yml and the server)
POSTGRES_DB=inova
POSTGRES_USER=inova
POSTGRES_PASSWORD=inova
POSTGRES_PORT=5432
DATABASE_URL=postgres://inova:inova@localhost:5432/inova

# pgAdmin (services/pgadmin/compose.yml) — browser DB UI on :5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=inova
PGADMIN_PORT=5050

# Inova plugin + firmware endpoints
INOVA_API_BASE_URL=http://192.168.1.146:5001
INOVA_FIRMWARE_BASE_URL=http://192.168.1.146

# Server
SERVER_PORT=3000

# Telemetry / camera polling rates
TELEMETRY_HZ=10
CAMERA_HZ=5
THERMAL_HZ=2

# Where camera frames are written on disk (relative to server/ CWD,
# resolves to <repo-root>/data/frames)
FRAMES_DIR=../data/frames
