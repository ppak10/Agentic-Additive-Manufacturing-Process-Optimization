[Unit]
Description=Agentic SLS agent session broker (chat panel backend, port 3100)
After=network-online.target

[Service]
WorkingDirectory=/mnt/storage2/GitHub/Agentic-Additive-Manufacturing-Process-Optimization
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/mnt/storage2/GitHub/Agentic-Additive-Manufacturing-Process-Optimization/node_modules/.bin/tsx harness/server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
