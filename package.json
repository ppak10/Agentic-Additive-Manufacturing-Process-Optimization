{
  "name": "agentic-sls",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "services/plugins/.opencode/plugins/agentic-sls.ts",
  "workspaces": [
    "services/recorder",
    "services/web",
    "services/plugins/mcp",
    "services/harness"
  ],
  "scripts": {
    "dev:server": "npm run dev -w agentic-sls-server",
